# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Set this in production to prevent paid plans from being activated without a
# confirmed payment. Leave false only for local development or an intentionally
# unbilled deployment.
BILLING_REQUIRE_PAYMENT="false"

# Required for the scheduled billing/retry task. Use a long random secret.
CRON_SECRET=""

# Email through Resend. Without these, outgoing email is console-only.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# SMS through Africa's Talking. Both values are needed.
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_USERNAME=""
AT_DELIVERY_REPORT_SECRET=""

# Platform subscription checkout (optional if the app is intentionally
# unbilled). Configure a live key and webhook secret only after staging checks.
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""
PAYCHANGU_BASE_URL="https://api.paychangu.com"

# Business-owned online invoice payments. Keep this key stable: changing or
# losing it means each business must enter its gateway credentials again.
APP_ENCRYPTION_KEY=""

# Optional AI assistant
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Optional branding/contact details
NEXT_PUBLIC_CONTACT_EMAIL=""
PLATFORM_NAME=""
PLATFORM_EMAIL=""
PLATFORM_PHONE=""
PLATFORM_ADDRESS=""

# Optional local timezone override. Business dates use each business's setting.
TZ=""
